#!/bin/sh
# Contract: exit 127 = no real Claude binary found on this host; any other
# non-zero exit = the real binary itself failed.
set -eu

configured=__PFM_CONFIGURED_CLAUDE__
launcher="$HOME/.local/share/pfm/install/bin/claude"
real=

if [ -n "$configured" ] && [ -x "$configured" ] && [ "$configured" != "$launcher" ] && [ "$configured" != "$0" ]; then
	if ! [ "$configured" -ef "$launcher" ] 2>/dev/null; then real=$configured; fi
fi

if [ -z "$real" ]; then
	real=$("$HOME/.local/bin/pfm" internal claude-version || true)
	[ "$real" = "$launcher" ] && real=
fi

if [ -z "$real" ]; then
	canonical="$HOME/.local/bin/claude"
	old_ifs=$IFS
	IFS=:
	for directory in $PATH; do
		[ -n "$directory" ] || directory=.
		resolved=$(command -v "$directory/claude" 2>/dev/null || true)
		[ -n "$resolved" ] || continue
		[ "$resolved" = "$canonical" ] && continue
		[ "$resolved" = "$launcher" ] && continue
		[ "$resolved" = "$0" ] && continue
		if [ -e "$launcher" ] && [ "$resolved" -ef "$launcher" ] 2>/dev/null; then continue; fi
		real=$resolved
		break
	done
	IFS=$old_ifs
fi

if [ -z "$real" ]; then
	printf '%s\n' 'pfm claude launcher: no real Claude binary found' >&2
	exit 127
fi

exec "$HOME/.local/bin/pfm" internal launch --real "$real" -- "$@"
