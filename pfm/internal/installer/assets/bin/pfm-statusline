#!/usr/bin/env bash
# pfm-statusline — context-gauge overlay over `pfm statusline`.
# ORIGINAL lives at pfm/internal/installer/assets/bin/pfm-statusline, embedded into the pfm
# binary; `pfm install` materialises it at ~/.local/share/pfm/install/bin/pfm-statusline and
# symlinks ~/.local/bin/pfm-statusline to that managed copy — the installer owns the wiring
# end to end, never a hand symlink.
#
# Why it exists: pfm's gauge historically read token usage from stale internal state (rendered
# 0%). This wrapper recomputes true occupancy from the transcript's last main-chain usage
# (input + cache_read + cache_creation — prompt caching parks most context in cache_read) and
# rewrites ONLY the gauge bar + percent + urgency glyph. Any failure => pfm's original line, so
# this can never render worse than before.
# Post-compact window: between a compact and the next recorded turn, the last usage entry is
# the PRE-compact corpse — render instead the boundary's compactMetadata.postTokens plus the
# project's remembered system floor, marked "~" (estimate). Missing both => the pre-compact
# number stands (stale beats blank).
# Broken-state report: on any internal error the line passes through UNMODIFIED — the failure
# mode is "pfm's own gauge", never a blank statusline.
set -o pipefail
PFM_BIN="${PFM_BIN:-$HOME/.local/bin/pfm}"
command -v "$PFM_BIN" >/dev/null 2>&1 || PFM_BIN="$(command -v pfm)" || { cat; exit 0; }
IN="$(cat)"
OUT="$(printf '%s' "$IN" | "$PFM_BIN" statusline 2>/dev/null)"
[ -z "$OUT" ] && { printf '%s' "$IN" | "$PFM_BIN" statusline; exit $?; }

FIX="$(PFM_JSON="$IN" PFM_LINE="$OUT" python3 <<'PY' 2>/dev/null
import json, os, re, sys
from pathlib import Path
line = os.environ["PFM_LINE"]
try:
    j = json.loads(os.environ["PFM_JSON"])
except Exception:
    print(line.replace("1h?", "1h∞"), end=""); sys.exit(0)

tp  = j.get("transcript_path") or ""
mid = ((j.get("model") or {}).get("id") or "").lower()
win = 200_000 if "haiku" in mid else 1_000_000
env = os.environ.get("PFM_CONTEXT_WINDOW")
if env and env.isdigit(): win = int(env)

ctx = None
usage_idx = -1
boundary_idx = -1
boundary_post = 0
prompts = 0
try:
    last_claude = None
    last_codex = None
    codex_win = None
    with open(tp) as f:
        for idx, ln in enumerate(f):
            try: d = json.loads(ln)
            except Exception: continue
            pl = d.get("payload") or {}
            if pl.get("type") == "token_count":
                info = pl.get("info") or {}
                cur = info.get("last_token_usage") or info.get("total_token_usage") or {}
                if cur.get("input_tokens") is not None:
                    last_codex = cur
                    codex_win = info.get("model_context_window") or codex_win
                continue
            if d.get("type") == "system" and d.get("subtype") == "compact_boundary":
                boundary_idx = idx
                p = (d.get("compactMetadata") or {}).get("postTokens")
                boundary_post = p if isinstance(p, int) and p > 0 else 0
                continue
            if d.get("isSidechain") is True: continue
            # Human turns only: a tool_result rides back as type "user" with no
            # text block, and slash-command scaffolding is not a prompt either.
            if d.get("type") == "user" and not d.get("isMeta"):
                c = ((d.get("message") or {}).get("content"))
                if isinstance(c, str):
                    text = c
                elif isinstance(c, list):
                    text = "".join(b.get("text", "") for b in c
                                   if isinstance(b, dict) and b.get("type") == "text")
                else:
                    text = ""
                text = text.strip()
                # The harness speaks in the user's voice constantly — tool
                # results, task notifications, system reminders, slash-command
                # scaffolding. None of those are prompts the human typed.
                if text and not text.startswith((
                        "<local-command", "<command-name>", "<command-message>",
                        "<command-args>", "<task-notification", "<system-reminder",
                        "Caveat:")):
                    prompts += 1
            u = (d.get("message") or {}).get("usage") or d.get("usage")
            if u and (u.get("input_tokens") is not None or u.get("cache_read_input_tokens") is not None):
                last_claude = u
                usage_idx = idx
    if last_claude:
        ctx = (last_claude.get("input_tokens") or 0) + (last_claude.get("cache_read_input_tokens") or 0) \
              + (last_claude.get("cache_creation_input_tokens") or 0)
    elif last_codex:
        ctx = last_codex.get("input_tokens") or last_codex.get("total_tokens") or 0
        if codex_win: win = codex_win
except Exception:
    ctx = None

# --- per (harness, project) baseline memory ---
harness = "codex" if ("/.codex/" in tp or "codex" in mid or mid.startswith("gpt")) else "claude"
proj = re.sub(r"[^A-Za-z0-9]+", "-", (j.get("cwd") or "root")).strip("-")[:80] or "root"
cache_dir = Path.home() / ".cache" / "pfm-statusline"
cache = cache_dir / f"{harness}-{proj}.txt"

# a compact boundary NEWER than the last usage entry means that usage is the pre-compact corpse
stale_compact = boundary_idx >= 0 and boundary_idx > usage_idx

if ctx and not stale_compact:
    # remember the smallest context ever seen for this project = its loaded-system floor
    try:
        prev = int(cache.read_text().strip()) if cache.exists() else None
    except Exception:
        prev = None
    floor = ctx if prev is None else min(prev, ctx)
    if floor != prev:
        try:
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(str(floor))
        except Exception:
            pass
    est = False
else:
    # post-compact window or nothing recorded yet: floor (loaded system) + the boundary's
    # postTokens (retained conversation) is the honest estimate; both absent -> the
    # pre-compact number stands (stale beats blank)
    try:
        floor = int(cache.read_text().strip()) if cache.exists() else 0
    except Exception:
        floor = 0
    guess = floor + (boundary_post if stale_compact else 0)
    ctx = guess or ctx or 0
    est = True

if not ctx:
    print(line.replace("1h?", "1h∞"), end=""); sys.exit(0)

pct   = max(0, min(100, round(100 * ctx / win)))
fill  = round(pct / 10)
bar   = "▰" * fill + "▱" * (10 - fill)
color = "1;32" if pct < 50 else ("1;33" if pct < 80 else "1;31")
# The raw token count used to ride here, beside the percent — but pfm's own
# 🧮 segment already carries it, so it was the same number printed twice. The
# estimate marker it used to carry moves onto the percent, where it still says
# "this reading is a post-compact estimate, not a measurement".
tilde = "~" if est else ""

# --- meltdown ladder: one milestone per 5%, driven by the TRUE pct ---
# pfm's own urgencyEmoji() picks from ITS percentage; recompute here where the number is real.
# Every rung is a single East-Asian-Width=W code point, never a narrow base + U+FE0F: tmux
# widens a VS16 sequence to 2 cells while xterm.js (VS Code) keeps it at 1, so one such rung at
# column 0 lands every partial repaint of this row — the cache timer, each tick — one cell off.
LADDER = ["🧊", "⛄", "💧", "🌊", "🌁",
          "⛅", "🔅", "🌞", "🥵", "⚡",
          "🔆", "🎇", "🔥", "🧨", "🧯",
          "🌠", "🌋", "🚨", "💣", "💀"]
glyph = LADDER[min(len(LADDER) - 1, pct // 5)]

new_gauge = f"\x1b[{color}m{bar}\x1b[0m \x1b[{color}m{tilde}{pct}%\x1b[0m"
# The gauge in pfm's line is glyph cells INTERLEAVED with ANSI escapes: makeBar emits
# color + filled-cells + dim + empty-cells, so an escape sits MID-BAR whenever the
# percentage is nonzero. Match glyph runs joined by escapes, then the percent.
GAUGE = r"(?:\x1b\[[0-9;]*m)*[▰▱]+(?:(?:\x1b\[[0-9;]*m)+[▰▱]+)*(?:\x1b\[[0-9;]*m|\s)*\d{1,3}%(?:\x1b\[[0-9;]*m)*"
patched, hits = re.subn(r"(?:🚨|🔥|⚡|🟢)\s*" + GAUGE,
                        glyph + " " + new_gauge, line, count=1)
if not hits:
    # pfm changed its emoji set -> still fix the gauge; never render worse than before
    patched = re.sub(GAUGE, new_gauge, line, count=1)
# Prompt count rides beside pfm's 🧮 token segment — the transcript scan above
# already visited every line, so counting human turns costs no extra read.
if prompts > 0:
    patched = re.sub(r"(🧮[^\x1b]*)", lambda m: m.group(1) + f" \x1b[2m✎{prompts}\x1b[0m",
                     patched, count=1)
# cache TTL unknown "1h?" -> "1h∞" (infinite), per user ruling 2026-08-28
patched = patched.replace("1h?", "1h∞")
print(patched, end="")
PY
)"
if [ -n "$FIX" ]; then printf '%s' "$FIX"; else printf '%s' "$OUT"; fi
